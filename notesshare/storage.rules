rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function validUpload(ownerUid) {
      return signedIn()
        && request.auth.uid == ownerUid
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf', 'image/jpeg', 'image/png',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ];
    }

    match /notes/{ownerUid}/free/{noteId}/{fileName} {
      allow read: if true;
      allow create: if validUpload(ownerUid);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == ownerUid;
    }

    match /notes/{ownerUid}/paid/{noteId}/{fileName} {
      allow read: if signedIn() && request.auth.uid == ownerUid;
      allow create: if validUpload(ownerUid);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == ownerUid;
    }
  }
}
