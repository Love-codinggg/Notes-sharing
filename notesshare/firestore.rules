rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /notes/{noteId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'title', 'subject', 'price', 'by', 'ownerUid',
          'storagePath', 'fileName', 'contentType', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'subject', 'price', 'by', 'ownerUid',
          'storagePath', 'fileName', 'contentType', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 40
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.price <= 999
        && request.resource.data.by is string
        && request.resource.data.by.size() <= 60
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.fileName is string
        && request.resource.data.fileName.matches('^[A-Za-z0-9._-]+$')
        && request.resource.data.contentType in [
          'application/pdf', 'image/jpeg', 'image/png',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ]
        && request.resource.data.storagePath
          == 'notes/' + request.auth.uid + '/'
            + (request.resource.data.price == 0 ? 'free/' : 'paid/')
            + noteId + '/' + request.resource.data.fileName
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

  }
}
